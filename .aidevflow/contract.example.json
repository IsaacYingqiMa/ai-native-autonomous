{
  "schema": "aidevflow/contract-v1",
  "task_id": "SAMPLE-001",
  "title": "Sample feature task",
  "method": {
    "name": "zsspec",
    "profile": "zsspec-docs-v2",
    "slug": "feature",
    "acceptance_map": {
      "REQ-feature-目标": [
        "S1"
      ]
    },
    "task_tests": {
      "S1-1": [
        "tests/test_feature.py"
      ]
    },
    "stages": {
      "design": [
        "zsspec-spec",
        "zsspec-plan"
      ],
      "build": [
        "zsspec-apply"
      ],
      "review": []
    }
  },
  "max_repair_attempts": 3,
  "work_plan_required": true,
  "test_timeout_seconds": 300,
  "code_paths": [
    "src/**",
    "app/**",
    "backend/**",
    "frontend/src/**"
  ],
  "evidence_paths": [
    "specs/checklist/reports",
    "test-results",
    "playwright-report"
  ],
  "design_artifacts": [
    "specs/active/feature/spec.md",
    "specs/active/feature/plan.md"
  ],
  "test_files": [
    "tests/test_feature.py"
  ],
  "test_support_files": [],
  "red_test_files": [
    "tests/test_feature.py"
  ],
  "test_commands": {
    "red": [
      "python",
      "-m",
      "pytest",
      "{target}",
      "-q"
    ],
    "green": [
      "python",
      "-m",
      "pytest",
      "{target}",
      "-q"
    ],
    "regression": [
      "python",
      "-m",
      "pytest",
      "tests",
      "-q"
    ]
  },
  "acceptance_items": [
    {
      "id": "REQ-feature-目标",
      "criterion": "Replace this with an observable acceptance criterion."
    }
  ],
  "required_checks": [
    {
      "id": "CHECK-static",
      "kind": "static",
      "acceptance_items": [
        "REQ-feature-目标"
      ]
    },
    {
      "id": "CHECK-feature",
      "suite": "green",
      "target": "tests/test_feature.py",
      "acceptance_items": [
        "REQ-feature-目标"
      ]
    },
    {
      "id": "CHECK-regression",
      "suite": "regression",
      "acceptance_items": [
        "REQ-feature-目标"
      ]
    }
  ],
  "routing": {
    "acceptance_test_failure": {
      "to": "build"
    },
    "review_finding": {
      "to": "build"
    },
    "spec_ambiguity": {
      "to": "needs_human"
    },
    "integrity_mismatch": {
      "to": "needs_human"
    }
  },
  "verifier": {
    "required": true,
    "input_policy": "bundle-only",
    "required_fields": [
      "task_id",
      "spec_version",
      "items",
      "risks"
    ]
  }
}
