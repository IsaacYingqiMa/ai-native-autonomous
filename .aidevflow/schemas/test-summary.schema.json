{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executed test case summary",
  "type": "object",
  "required": ["schema", "cases"],
  "properties": {
    "schema": {"const": "aidevflow/test-summary-v1"},
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "skipped", "xfail", "deselected"]}
        }
      }
    }
  }
}
