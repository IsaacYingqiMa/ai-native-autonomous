{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIDevFlow execution binding",
  "type": "object",
  "required": [
    "schema",
    "runtime",
    "adapter_version",
    "skills_root"
  ],
  "properties": {
    "schema": {
      "const": "aidevflow/execution-binding-v1"
    },
    "runtime": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "skills_root": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
