{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "bundle_sha256",
    "decision",
    "reason",
    "acceptance_ids",
    "changed_paths"
  ],
  "properties": {
    "schema": {
      "const": "aidevflow/baseline-review-v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "bundle_sha256": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "approve",
        "revise"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "severity",
          "path",
          "acceptance_ids",
          "reason"
        ],
        "properties": {
          "category": {
            "enum": [
              "test",
              "design",
              "plan",
              "environment",
              "scope"
            ]
          },
          "severity": {
            "enum": [
              "blocking",
              "suggestion"
            ]
          },
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
