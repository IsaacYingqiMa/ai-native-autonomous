{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "bundle_sha256", "decision", "reason", "items"],
  "properties": {
    "schema": {"const": "aidevflow/light-verdict-v1"},
    "run_id": {"type": "string"},
    "bundle_sha256": {"type": "string"},
    "decision": {"enum": ["pass", "revise"]},
    "reason": {"type": "string", "minLength": 1},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "reason", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^S[0-9]+$"}, "status": {"enum": ["passed", "failed"]},
          "reason": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^objects/[0-9a-f]{64}$"}}
        }
      }
    }
  }
}
