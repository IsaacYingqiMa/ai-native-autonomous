+        ('path_layout', ('规格路径与计划不一致', '测试目标与计划不一致', '任务文件使用规范', '任务不能修改受管资源',
+                         '草稿必须是', '规格缺少章节', '规格需要唯一', '每条规格需要', '冲突声明', '规格必须精确映射')),
+        ('plan_shape', ('计划需要已批准规格', '任务 kind', '任务需要', '每项任务必须', '环境准备必须', '全量回归必须',
+                        'RED/GREEN/REFACTOR', '实现和重构不能', 'REFACTOR 必须', '测试文件不能同时',
+                        'GREEN/REFACTOR 必须', '需要已结束的真实失败', '只可在授权执行范围', 'retry 只适用')),
+        ('native_review', ('修订需要现存冻结', '修订提案已经过期', '修订目标在审查后变化', '独立验收', '验收',
+                           '正式需求', '冻结测试已修改', '先编写当前 RED', '上次执行结果未知')),
+        ('transport', ('只接受当前操作的明确字段', '操作参数必须', '该操作只接受原生用户命令')),
+    )
+    for name, needles in buckets:
+        if any(n in text for n in needles):
+            return name
+    return 'other'
